{
  "name": "bugtriageapp",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "db:generate": "dotenv -- drizzle-kit generate",
    "db:migrate": "dotenv -- drizzle-kit migrate",
    "dev": "dotenv -- node server.js",
    "start": "node server.js",
    "typecheck": "react-router typegen && tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "ui:add": "npx shadcn@latest add --yes",
    "ui:postadd": "node -e \"const fs=require('fs'),p=require('path');const src=p.join(process.cwd(),'components','kibo-ui');const dst=p.join(process.cwd(),'app','components','kibo-ui');if(fs.existsSync(src)){fs.mkdirSync(dst,{recursive:true});for(const e of fs.readdirSync(src)){fs.cpSync(p.join(src,e),p.join(dst,e),{recursive:true,force:true});fs.rmSync(p.join(src,e),{recursive:true,force:true});}fs.rmSync(src,{recursive:true,force:true});const root=p.join(process.cwd(),'components');if(fs.existsSync(root)&&fs.readdirSync(root).length===0)fs.rmdirSync(root);console.log('Moved kibo-ui components to app/components/kibo-ui');}\""
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@hookform/resolvers": "5.2.2",
    "@neondatabase/neon-js": "^0.6.1-beta",
    "@radix-ui/react-use-controllable-state": "^1.2.2",
    "@react-router/express": "7.15.0",
    "@react-router/node": "7.15.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.0",
    "date-fns": "^4.1.0",
    "drizzle-orm": "~0.45.2",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "isbot": "^5.1.36",
    "lucide-react": "^1.16.0",
    "morgan": "^1.10.0",
    "motion": "^12.38.0",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.8",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-day-picker": "^10.0.0",
    "react-dom": "^19.2.6",
    "react-fast-marquee": "^1.6.5",
    "react-hook-form": "^7.75.0",
    "react-router": "7.15.0",
    "react-use-measure": "^2.1.7",
    "shadcn": "^4.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "7.15.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/compression": "^1.7.5",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.1",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20",
    "@types/pg": "^8.18.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.6",
    "dotenv-cli": "^8.0.0",
    "drizzle-kit": "~0.28.1",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^8.0.3",
    "vitest": "^4.1.6"
  }
}
